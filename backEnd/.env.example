PORT=4000

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/courses-platform?retryWrites=true&w=majority

# Public URL of the backend (required on Vercel for uploaded file links)
BASE_URL=http://localhost:4000

# Frontend URL(s) allowed by CORS (comma-separated for multiple)
FRONTEND_URL=http://localhost:5173

JWT_ACCESS_TOKEN_SECRET=your_secret_key_here
JWT_REFRESH_TOKEN_EXP=7d
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
